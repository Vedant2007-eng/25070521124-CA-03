{
  "name": "preppilot-ai-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "verify:models": "node scripts/verify-models.js",
    "test": "npm run test:models && npm run test:security && npm run test:auth && npm run test:planner && npm run test:quiz && npm run test:revision && npm run test:analytics",
    "test:models": "node scripts/verify-models.js",
    "test:security": "node --test test/security.test.js",
    "test:auth": "node --test test/auth.test.js",
    "test:planner": "node --test test/planner.test.js",
    "test:quiz": "node --test test/quiz.test.js",
    "test:revision": "node --test test/revision.test.js",
    "test:analytics": "node --test test/analytics.test.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5"
  }
}
