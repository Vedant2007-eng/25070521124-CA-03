PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/preppilot_ai
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated allowlist. In non-production, private-network HTTP origins
# are also accepted automatically so LAN development IP changes do not break CORS.
CLIENT_URL=http://localhost:5173

# In-memory per-IP brute-force protection for register and login.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MINUTES=15

# Set only when the API runs behind a trusted reverse proxy, so req.ip can use
# the forwarded client address. Use the number of trusted proxy hops or a
# trusted address/subnet. Do not enable this for direct public connections.
# TRUST_PROXY=1

# Server-side AI quiz generation. Never expose this key to the client.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000

# Quiz sessions live in memory until submitted or expired.
QUIZ_SESSION_TTL_MINUTES=30
QUIZ_GENERATION_RATE_LIMIT=10
QUIZ_GENERATION_RATE_WINDOW_MINUTES=10
